{
  "manifest_version": 3,
  "name": "charlie MJ - drive-media-downloader",
  "version": "1.0.0",
  "description": "Collects media requests visible to the browser in the current authorized session.",
  "permissions": [
    "webRequest",
    "downloads",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
